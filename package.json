{
  "name": "contactlint-mcp",
  "version": "1.1.0",
  "description": "Local stdio MCP server and bridge for ContactLint email and phone validation (https://contactlint.com/mcp)",
  "type": "module",
  "main": "./bin/contactlint-mcp.mjs",
  "bin": {
    "contactlint-mcp": "./bin/contactlint-mcp.mjs"
  },
  "files": [
    "bin/",
    "examples/",
    "server.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node ./bin/contactlint-mcp.mjs"
  },
  "keywords": [
    "mcp",
